{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Prose",
  "scopeName": "source.prose",
  "fileTypes": [
    "prose"
  ],
  "patterns": [
    {
      "include": "#markup-root"
    },
    {
      "include": "#standalone-comments"
    },
    {
      "include": "#patterns"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#parameters"
    },
    {
      "include": "#loop-iterators"
    },
    {
      "include": "#type-declarations"
    },
    {
      "include": "#bindings"
    },
    {
      "include": "#type-annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "match": "\\b[A-Z][A-Za-z_0-9]*\\b",
      "name": "support.class.prose",
      "captures": {
        "0": {
          "patterns": [
            {
              "include": "#name-separators"
            }
          ]
        }
      }
    },
    {
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b",
      "name": "variable.other.readwrite.prose",
      "captures": {
        "0": {
          "patterns": [
            {
              "include": "#name-separators"
            }
          ]
        }
      }
    }
  ],
  "repository": {
    "patterns": {
      "name": "string.regexp.prose",
      "begin": "\\b(pattern)\\s*(\")",
      "end": "(\")((?:\\s+(?:everywhere|ignoring\\s+case|by\\s+line))*)|$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.prose"
        },
        "2": {
          "name": "punctuation.definition.string.begin.prose"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.prose"
        },
        "2": {
          "name": "keyword.other.prose"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.prose",
          "match": "\\\\."
        }
      ]
    },
    "standalone-comments": {
      "name": "comment.line.string.prose",
      "match": "^\\s*\"(?:[^\"\\\\]|\\\\.)*\"\\s*$"
    },
    "strings": {
      "name": "string.quoted.double.prose",
      "begin": "\"",
      "end": "(\")|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.prose"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.prose"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.prose",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
        },
        {
          "name": "invalid.illegal.escape.prose",
          "match": "\\\\."
        }
      ]
    },
    "function-declarations": {
      "match": "\\b(function)\\s+(?!(?:takes|return)\\b)([A-Za-z_][A-Za-z_0-9]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.prose"
        },
        "2": {
          "name": "entity.name.function.prose",
          "patterns": [
            {
              "include": "#name-separators"
            }
          ]
        }
      }
    },
    "parameters": {
      "name": "meta.function.parameters.prose",
      "begin": "\\b(takes)\\b",
      "end": "(?=\\breturn\\b)|$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.prose"
        }
      },
      "patterns": [
        {
          "include": "#type-annotations"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b",
          "name": "variable.parameter.prose",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#name-separators"
                }
              ]
            }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameters.prose"
        }
      ]
    },
    "type-annotations": {
      "begin": "\\b(as|giving)\\b",
      "end": "(?=,|\\bis\\b|\\breturn\\b|$)",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.prose"
        }
      },
      "patterns": [
        {
          "include": "#types"
        }
      ]
    },
    "type-declarations": {
      "begin": "^\\s*(?:(export)\\s+)?(type)\\s+([A-Z][A-Za-z_0-9]*)\\s+(is)\\b",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.prose"
        },
        "2": {
          "name": "storage.type.prose"
        },
        "3": {
          "name": "entity.name.type.prose",
          "patterns": [
            {
              "include": "#name-separators"
            }
          ]
        },
        "4": {
          "name": "keyword.other.prose"
        }
      },
      "patterns": [
        {
          "include": "#types"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "match": "\\b(?:text|number|boolean|any|unknown|nothing|unset|null|true|false|object)\\b",
          "name": "support.type.prose"
        },
        {
          "match": "\\b(?:list|set|map|maybe|function|of|from|to|taking|giving|or|and)\\b",
          "name": "keyword.other.prose"
        },
        {
          "match": "\\b[A-Z][A-Za-z_0-9]*\\b",
          "name": "entity.name.type.prose",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#name-separators"
                }
              ]
            }
          }
        },
        {
          "match": "\\b[a-z_][A-Za-z_0-9]*\\b",
          "name": "entity.name.type.parameter.prose",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#name-separators"
                }
              ]
            }
          }
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<=\\buse\\s)type\\b",
          "name": "keyword.other.prose"
        },
        {
          "match": "\\barray\\b",
          "name": "storage.type.array.prose"
        },
        {
          "match": "\\bobject\\b",
          "name": "storage.type.object.prose"
        },
        {
          "match": "\\bfunction\\b",
          "name": "storage.type.function.prose"
        },
        {
          "match": "\\bwait\\s+for\\b|\\bon\\s+error\\b|\\b(?:if|then|else|for|each|in|while|return|skip|stop|try|fail)\\b|(?<=\\beach\\s)of\\b",
          "name": "keyword.control.prose"
        },
        {
          "match": "(?<=\\ba\\s|\\ban\\s)(?:text|number|boolean|function|list|object)\\b",
          "name": "support.type.prose"
        },
        {
          "match": "\\bis\\s+(?:not\\s+)?an?\\b(?=\\s+[A-Za-z])|\\b(?:is|are|to|print|run|with|new|use|export|as|giving|like)\\b|\\bfrom(?=\\s*\")",
          "name": "keyword.other.prose"
        },
        {
          "match": "\\b(?:async|await)\\b",
          "name": "keyword.control.experimental.prose"
        }
      ]
    },
    "builtins": {
      "match": "\\b(?:length|char_to_number|number_to_char|remainder)\\b",
      "name": "support.function.prose"
    },
    "constants": {
      "match": "\\b(?:true|false|null|unset)\\b",
      "name": "constant.language.prose"
    },
    "numbers": {
      "match": "\\b\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.prose"
    },
    "operators": {
      "patterns": [
        {
          "match": "\\bshifted\\s+(?:left|right)\\s+by\\b|\\b(?:and|or|not|mod|xor|otherwise|maybe)\\b",
          "name": "keyword.operator.word.prose"
        },
        {
          "match": "<=|>=|!=|[=<>+*/%\\-]",
          "name": "keyword.operator.prose"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\.",
          "name": "punctuation.accessor.prose"
        },
        {
          "match": "\\(",
          "name": "punctuation.section.group.begin.prose"
        },
        {
          "match": "\\)",
          "name": "punctuation.section.group.end.prose"
        },
        {
          "match": ",",
          "name": "punctuation.separator.arguments.prose"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.prose"
            },
            "2": {
              "name": "variable.other.property.prose",
              "patterns": [
                {
                  "include": "#name-separators"
                }
              ]
            }
          }
        },
        {
          "match": "(:)\\s*([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.object.prose"
            },
            "2": {
              "name": "variable.other.property.prose",
              "patterns": [
                {
                  "include": "#name-separators"
                }
              ]
            }
          }
        }
      ]
    },
    "loop-iterators": {
      "patterns": [
        {
          "begin": "\\b(for)\\s+(each)\\b",
          "end": "\\b(in)\\b|$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.prose"
            },
            "2": {
              "name": "keyword.control.prose"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.prose"
            }
          },
          "patterns": [
            {
              "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b",
              "name": "variable.other.iterator.prose",
              "captures": {
                "0": {
                  "patterns": [
                    {
                      "include": "#name-separators"
                    }
                  ]
                }
              }
            },
            {
              "match": ",",
              "name": "punctuation.separator.parameters.prose"
            }
          ]
        },
        {
          "match": "\\b(for)\\s+([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "keyword.control.prose"
            },
            "2": {
              "name": "variable.other.iterator.prose",
              "patterns": [
                {
                  "include": "#name-separators"
                }
              ]
            }
          }
        }
      ]
    },
    "bindings": {
      "match": "^\\s*(?:(export)\\s+)?([A-Za-z_][A-Za-z_0-9]*)(?=\\s+(?:is|as)\\b)",
      "captures": {
        "1": {
          "name": "keyword.other.prose"
        },
        "2": {
          "name": "variable.other.binding.prose",
          "patterns": [
            {
              "include": "#name-separators"
            }
          ]
        }
      }
    },
    "name-separators": {
      "match": "_",
      "name": "punctuation.separator.name.prose"
    },
    "markup-expression": {
      "name": "meta.embedded.expression.prose",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.prose"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.prose"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "markup-header": {
      "begin": "\\G",
      "end": "(?=/>)|(?<=>)",
      "patterns": [
        {
          "include": "#markup-expression"
        },
        {
          "name": "string.quoted.double.prose",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.prose",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "variable.other.property.prose",
          "match": "[A-Za-z_][A-Za-z_0-9-]*",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#name-separators"
                }
              ]
            }
          }
        },
        {
          "name": "keyword.operator.prose",
          "match": "="
        },
        {
          "name": "punctuation.definition.tag.end.prose",
          "match": ">"
        }
      ]
    },
    "markup-element": {
      "name": "meta.markup.prose",
      "begin": "(<)([A-Za-z_][A-Za-z_0-9.-]*|)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)(\\s*>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.prose"
        },
        "2": {
          "name": "entity.name.tag.prose",
          "patterns": [
            {
              "include": "#name-separators"
            }
          ]
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.prose"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.prose"
        },
        "3": {
          "name": "entity.name.tag.prose",
          "patterns": [
            {
              "include": "#name-separators"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.end.prose"
        }
      },
      "patterns": [
        {
          "include": "#markup-header"
        },
        {
          "include": "#markup-element"
        },
        {
          "include": "#markup-expression"
        },
        {
          "name": "constant.character.escape.prose",
          "match": "&(?:#x[0-9a-fA-F]+|#\\d+|[A-Za-z]+);"
        }
      ]
    },
    "markup-root": {
      "name": "meta.markup.prose",
      "begin": "(?:(?<=\\breturn)|(?<=\\bis)|(?<=\\bare)|(?<=\\bprint)|(?<=\\bwith)|(?<=\\belse)|(?<=\\bthen)|(?<=\\bif)|(?<=\\band)|(?<=\\bor)|(?<=\\bfail)|(?<=\\botherwise)|(?<=[(,=+*/{])|^)\\s*(<)([A-Za-z_][A-Za-z_0-9.-]*|)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)(\\s*>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.prose"
        },
        "2": {
          "name": "entity.name.tag.prose",
          "patterns": [
            {
              "include": "#name-separators"
            }
          ]
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.prose"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.prose"
        },
        "3": {
          "name": "entity.name.tag.prose",
          "patterns": [
            {
              "include": "#name-separators"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.end.prose"
        }
      },
      "patterns": [
        {
          "include": "#markup-header"
        },
        {
          "include": "#markup-element"
        },
        {
          "include": "#markup-expression"
        },
        {
          "name": "constant.character.escape.prose",
          "match": "&(?:#x[0-9a-fA-F]+|#\\d+|[A-Za-z]+);"
        }
      ]
    }
  }
}
