{
  "name": "prose-language",
  "displayName": "Prose Language",
  "description": "Semantic and syntax highlighting, formatting, type checking, quick fixes, autocomplete, parameter hints, navigation, references, and rename for Prose.",
  "version": "0.1.28",
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onLanguage:prose"],
  "scripts": {
    "vscode:prepublish": "node build.mjs"
  },
  "publisher": "travisk-codes",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/travisk-codes/prose-lang.git",
    "directory": "editors/vscode"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting and formatting work in Restricted Mode. Type checking and semantic editor features load the project's TypeScript and require Workspace Trust."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting and formatting are available. Type checking and semantic editor features require a local project."
    }
  },
  "contributes": {
    "commands": [{
      "command": "prose.check",
      "title": "Check Open Files",
      "category": "Prose",
      "enablement": "isWorkspaceTrusted"
    }],
    "configuration": {
      "title": "Prose",
      "properties": {
        "prose.check.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Check open Prose files after a short pause in typing, using current buffers and the project's TypeScript. Diagnostics appear in the editor and Problems panel."
        },
        "prose.check.strict": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Also report any in function parameters and exported return/value contracts. Applies to checked Prose files and their Prose dependencies in this project; off by default."
        },
        "prose.hover.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show inferred types and function signatures on hover using the project's TypeScript and current editor buffers. Requires Workspace Trust."
        },
        "prose.completion.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Suggest in-scope variables, parameters, functions, and typed properties and methods using current buffers. Requires Workspace Trust and the project's TypeScript."
        },
        "prose.definition.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable Go to Definition for Prose variables and functions, including imported Prose modules. Uses current buffers and requires Workspace Trust."
        },
        "prose.signatureHelp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show function parameter hints and highlight the current argument while typing calls. Uses current buffers and requires Workspace Trust and the project's TypeScript."
        },
        "prose.references.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Find references to Prose value bindings, including direct Prose consumers across the project. Uses current buffers and project TypeScript; requires Workspace Trust."
        },
        "prose.rename.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Rename Prose variables, parameters, and functions, including exports and direct Prose imports across the project. Rejects collisions, capture, and ambiguous dots. Requires Workspace Trust and project TypeScript."
        },
        "prose.semanticHighlighting.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Color function values, parameters, variables, properties, and known numeric indexes using project types and current buffers. Requires Workspace Trust and project TypeScript."
        },
        "prose.quickFixes.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Offer explicit argument-list and array readings for ambiguous calls through Quick Fix (Ctrl+.). Requires Workspace Trust and project TypeScript."
        },
        "prose.format.width": {
          "type": "integer",
          "minimum": 20,
          "default": 80,
          "description": "Preferred line width when formatting Prose. Strings and expressions without a safe break can exceed it."
        }
      }
    },
    "languages": [
      {
        "id": "prose",
        "aliases": [
          "Prose",
          "prose"
        ],
        "extensions": [
          ".prose"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "prose",
        "scopeName": "source.prose",
        "path": "./syntaxes/prose.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      { "id": "proseFunction", "description": "A Prose function or function-valued name." },
      { "id": "proseParameter", "description": "A reference to a function parameter." },
      { "id": "proseVariable", "description": "A reference to an ordinary Prose value binding." },
      { "id": "proseBinding", "description": "A Prose variable declaration or assignment." },
      { "id": "proseProperty", "description": "A Prose object property name." },
      { "id": "proseIterator", "description": "A loop variable or its reference." },
      { "id": "proseBuiltin", "description": "A Prose standard-library function or native JavaScript function." }
    ],
    "semanticTokenScopes": [{
      "language": "prose",
      "scopes": {
        "proseFunction": ["source.prose entity.name.function.prose"],
        "proseParameter": ["source.prose variable.parameter.prose"],
        "proseVariable": ["source.prose variable.other.readwrite.prose"],
        "proseBinding": ["source.prose variable.other.binding.prose"],
        "proseProperty": ["source.prose variable.other.property.prose"],
        "proseIterator": ["source.prose variable.other.iterator.prose"],
        "proseBuiltin": ["source.prose support.function.prose"]
      }
    }],
    "configurationDefaults": {
      "[prose]": {
        "editor.defaultFormatter": "travisk-codes.prose-language"
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "name": "Prose: Variables",
            "scope": [
              "source.prose variable.other.readwrite.prose"
            ],
            "settings": {
              "foreground": "#C5D9F5",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Bindings",
            "scope": [
              "source.prose variable.other.binding.prose"
            ],
            "settings": {
              "foreground": "#85B7F4",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Loop iterators",
            "scope": [
              "source.prose variable.other.iterator.prose"
            ],
            "settings": {
              "foreground": "#B7E16E",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Properties",
            "scope": [
              "source.prose variable.other.property.prose"
            ],
            "settings": {
              "foreground": "#64D6C7",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Parameters",
            "scope": [
              "source.prose variable.parameter.prose"
            ],
            "settings": {
              "foreground": "#B7E16E",
              "fontStyle": "italic"
            }
          },
          {
            "name": "Prose: Control flow",
            "scope": [
              "source.prose keyword.control.prose",
              "source.prose keyword.control.experimental.prose"
            ],
            "settings": {
              "foreground": "#F58C8F",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Language words",
            "scope": [
              "source.prose keyword.other.prose"
            ],
            "settings": {
              "foreground": "#C79EF4",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Function declarations",
            "scope": [
              "source.prose storage.type.function.prose"
            ],
            "settings": {
              "foreground": "#F5E07B",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Function names",
            "scope": [
              "source.prose entity.name.function.prose"
            ],
            "settings": {
              "foreground": "#F5E07B",
              "fontStyle": "bold"
            }
          },
          {
            "name": "Prose: Types",
            "scope": [
              "source.prose support.type.prose",
              "source.prose entity.name.type.prose",
              "source.prose support.class.prose"
            ],
            "settings": {
              "foreground": "#F392A2",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Type variables",
            "scope": [
              "source.prose entity.name.type.parameter.prose"
            ],
            "settings": {
              "foreground": "#F392A2",
              "fontStyle": "italic"
            }
          },
          {
            "name": "Prose: Standard library",
            "scope": [
              "source.prose support.function.prose"
            ],
            "settings": {
              "foreground": "#66D6E9",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Objects and arrays",
            "scope": [
              "source.prose storage.type.object.prose",
              "source.prose storage.type.array.prose"
            ],
            "settings": {
              "foreground": "#9CA3F0",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Strings",
            "scope": [
              "source.prose string.quoted.double.prose"
            ],
            "settings": {
              "foreground": "#7CDA9E",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Patterns",
            "scope": [
              "source.prose string.regexp.prose"
            ],
            "settings": {
              "foreground": "#E799F3",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: String escapes",
            "scope": [
              "source.prose constant.character.escape.prose"
            ],
            "settings": {
              "foreground": "#F5E07B",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Comments",
            "scope": [
              "source.prose comment.line.string.prose"
            ],
            "settings": {
              "foreground": "#979FB8",
              "fontStyle": "italic"
            }
          },
          {
            "name": "Prose: Numbers",
            "scope": [
              "source.prose constant.numeric.prose"
            ],
            "settings": {
              "foreground": "#F5AA6C",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Booleans and null",
            "scope": [
              "source.prose constant.language.prose"
            ],
            "settings": {
              "foreground": "#F3C962",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Operators",
            "scope": [
              "source.prose keyword.operator.prose",
              "source.prose keyword.operator.word.prose"
            ],
            "settings": {
              "foreground": "#EC93C4",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Accessors",
            "scope": [
              "source.prose punctuation.accessor.prose",
              "source.prose punctuation.accessor.object.prose"
            ],
            "settings": {
              "foreground": "#6D7182",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Name separators",
            "scope": ["source.prose punctuation.separator.name.prose"],
            "settings": {
              "foreground": "#6D7182",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Commas and parentheses",
            "scope": [
              "source.prose punctuation.separator.arguments.prose",
              "source.prose punctuation.separator.parameters.prose",
              "source.prose punctuation.section.group.begin.prose",
              "source.prose punctuation.section.group.end.prose"
            ],
            "settings": {
              "foreground": "#ADB5CC",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: String quotes",
            "scope": [
              "source.prose punctuation.definition.string.begin.prose",
              "source.prose punctuation.definition.string.end.prose"
            ],
            "settings": {
              "foreground": "#6AD5AB",
              "fontStyle": ""
            }
          },
          {
            "name": "Prose: Invalid escapes",
            "scope": [
              "source.prose invalid.illegal.escape.prose"
            ],
            "settings": {
              "foreground": "#F37086",
              "fontStyle": "underline"
            }
          }
        ]
      }
    }
  },
  "files": [
    "extension.cjs",
    "formatting.cjs",
    "checking.cjs",
    "hovering.cjs",
    "completing.cjs",
    "signatures.cjs",
    "refactoring.cjs",
    "semantic.cjs",
    "quick-fixes.cjs",
    "check-worker.cjs",
    "dist/**",
    "package.json",
    "language-configuration.json",
    "syntaxes/**",
    "README.md",
    "LICENSE"
  ]
}
