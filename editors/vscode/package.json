{
  "name": "prose-language",
  "displayName": "Prose Language",
  "description": "Syntax highlighting for the Prose concept programming language.",
  "version": "0.1.2",
  "publisher": "travisk-codes",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/travisk-codes/prose-lang.git",
    "directory": "editors/vscode"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "prose",
        "aliases": [
          "Prose",
          "prose"
        ],
        "extensions": [
          ".prose"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "prose",
        "scopeName": "source.prose",
        "path": "./syntaxes/prose.tmLanguage.json"
      }
    ]
  },
  "files": [
    "package.json",
    "language-configuration.json",
    "syntaxes/**",
    "README.md",
    "LICENSE"
  ]
}
