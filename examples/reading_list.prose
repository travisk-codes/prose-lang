"A reading list built from JavaScript arrays, maps, methods, and functions as values."

shelf is ("Middlemarch", 880, true), ("Piranesi", 272, false), ("Beloved", 324, true)

books is array
for each title, pages, done in shelf
    book is object
        title is title
        pages is pages
        done is done
    books:push with book

"An inline if chooses between two values."
function status takes book
    return if book:done then "read" else "to read"

"An inline function: everything after return is its result."
finished is books:filter with function takes book return book:done
titles is finished:map with function takes book return book:title
print "Finished: " + (titles:join with ", ")

"A function with an indented body, passed as the last argument."
labels is books:map with function takes book
    if book:pages > 500 return book:title + " (long)"
    return book:title
print labels:join with ", "

"A Map from JavaScript counts books by status; otherwise supplies 0 the first time."
counts is new Map
for each book in books
    count is counts:get with (status book) otherwise 0
    counts:set with (status book), (count + 1)
for each label, count in counts
    print label + ": " + count

"Arguments bind before arithmetic, so the division needs parentheses."
total is 0
for each book in books
    total is total + book:pages
print "Average pages: " + (Math:round with (total / length books))

"Functions are values that can be stored and called with with, or with run when they take nothing."
shout is function takes text return text:toUpperCase run
print shout with "done"
abandoned is counts:get with "abandoned"
print "Abandoned: " + (abandoned otherwise 0)
