"A module for tour_simplified.prose: an exported type, an exported variable,"
"and an exported function with an optional argument."

"Greetings are text."
export type Greeting is text

export greeting as Greeting is "Hello"

export function greet takes name as text,
        punctuation as maybe text, giving Greeting
    if punctuation = unset punctuation is "!"
    return greeting + ", " + name + punctuation
