"A tour of everything Prose supports. Run it with: node bin/prose.js"
"examples/tour.prose --run"

use greet, greeting from "./tour_helpers.prose"
use type Greeting from "./tour_helpers.prose"
use basename from "node:path"

"--- Values. A quoted string on its own line, like this one, is a comment."
answer is 42
ratio is 2.5
quote is "She said \"hi\"!"
yes is true
no is false
nothing is null
missing
also_missing is
print answer
print quote
print nothing = null and missing = unset and also_missing = unset

"--- Arithmetic: precedence, grouping, unary minus, %, prefix remainder, and"
"mod."
print 2 + 3 * 4 - 10 / 5
print (2 + 3) * -2
print 17 % 5
print remainder 17 5
print -1 % 26
print -1 mod 26

"--- Comparison and logic. otherwise replaces only unset and null; or replaces"
"any false value."
print 3 >= 3 and 2 != 3 and not (1 > 2) and 1 < 2 and 2 <= 2
print no or "or fallback"
print nothing otherwise "otherwise fallback"
print 0 otherwise 5

"--- Branches: if, else if, else, inline statements, and inline if values."
function size_of takes n
    if n < 10
        return "small"
    else if n < 100
        return "medium"
    else
        return "large"
print size_of 5
print size_of 50
print size_of 500
if answer = 42 print "inline if statement"
if false print "not printed"
else if yes print "inline else if"
else print "not printed either"
print if ratio > 2 then "big ratio" else "small ratio"

"--- Loops: counting with for, while, and for each over lists, strings, and"
"pairs."
total is 0
for i is 1 to 4
    total is total + i
print total
countdown is 3
while countdown > 0
    print countdown
    countdown is countdown - 1
for each letter in "a😀"
    print letter
for each word, position in ("first", 1), ("second", 2)
    print word + " " + position

"--- Functions: recursion, calling ahead, no arguments, bare return, and the"
"call-first rule."
function factorial takes n
    if n <= 1 return 1
    return n * factorial (n - 1)
print factorial 5
print factorial 3 + 1
print twice_plus 3, 1
function twice_plus takes value, extra
    return value * 2 + extra
function announce
    print "announcing"
    return
announce run

"--- Modules: an imported Prose function (with leaves out its optional"
"argument), an imported variable, and JavaScript."
print greet with "Ada"
print greet "Grace", "?"
print greeting
print basename "/notes/today.txt"

"--- Strings: one-based Unicode positions, the standard library, and writes."
word is "h😀llo"
print length word
print word.2
print char_to_number "A"
print number_to_char 97
word.1 is "H"
word.(length word + 1) is "!"
print word
built
built.1 is "o"
built.2 is "k"
print built

"--- Objects: nested literals, colon access, changes, function values, and"
"returning objects."
person is object
    name is "Ada"
    address is object
        city is "London"
    describe is function takes who return who:name + " of " + who:address:city
print person:address:city
person:address:city is "Paris"
person:name.1 is "E"
print person:describe person
empty is object
empty:added is "later"
print empty:added
print empty:nothing = unset
function make_point takes x, y
    return object
        x is x
        y is y
point is make_point 3, 4
print point:x + point:y

"--- Arrays: commas, one item, empty, nesting, positions, appending, sharing,"
"and copies."
numbers is 3, 1, 2
single is ("only",)
empty_list is array
grid is (1, 2), (3, 4)
row is 2
column is 1
print numbers.1 + length single + length empty_list
print (grid.2).1
print grid.(1).2
print grid.row.column
numbers.(length numbers + 1) is 4
shared is numbers
shared.1 is 30
copy is numbers:slice run
copy.1 is 300
print numbers
print copy.1

"--- Function values: inline and indented bodies, passed to methods and to"
"Prose functions."
sorted is numbers:to_sorted function takes a, b return a - b
print sorted
evens is sorted:filter function takes n return n mod 2 = 0
print evens
labels is sorted:map function takes n, index
    prefix is "#" + (index + 1)
    return prefix + "=" + n
print labels:join ", "
square is function takes n return n * n
print square 9
seven is function return 7
print seven run
function apply_twice takes action, value
    return action (action value)
print apply_twice square, 3
function after takes action, delay
    return action run + " after " + delay
print after function, 5
    return "ran"

"--- JavaScript: globals, methods called with the values after them, run for"
"none, and new."
print Math:max 4, 9, 2
print (Math:round (10 / 3)):to_fixed 1
print "Prose":to_upper_case run
print JSON:stringify point
seen is new Set ("a", "b", "a")
print seen:size
lookup is new Map
lookup:set "key", ("val" + "ue")
"Parentheses say what a call's result does next, and which call gets each"
"argument."
print (lookup:get "key") + "!"
print Math:max (Math:min 5, 8), 6
"with is optional, and needed before a negative first argument."
print Math:min with 3, 1
print numbers:at with -1
"then starts an inline if's body when the condition ends in a call."
found is false
if seen:has "a" then found is true
print found

"--- maybe: reading through values that might be missing."
profile is object
    name is "Grace"
    nickname is
print maybe profile:address:city
print maybe profile:address:city otherwise "no city"
print maybe profile:name:to_upper_case run
print maybe profile:nickname:length otherwise 0
print maybe profile:tags.1 otherwise "no tags"
callback is unset
maybe callback run
print (maybe callback run) otherwise "no callback"

"--- Objects on one line, spreading with each of, and taking lists apart with"
"are."
title is "Dr."
greeting_card is object title, name is "Ada", lines is 2
updated_card is object like greeting_card, lines is 3
print JSON:stringify updated_card
print greeting_card:lines
low, high are 4, 9
low, high are high, low
print (each of numbers, low, high)
print Math:min each of numbers

"--- skip moves to the next turn of a loop, and stop leaves it."
picked is array
for each n in 1, 2, 3, 4, 5, 6
    if n mod 2 = 0 skip
    if n > 4 stop
    picked:push n
print picked

"--- Patterns: regular expressions, with backslashes kept as typed."
date is "2026-10-28"
year, month are (date:match pattern "^(\d{4})-(\d{2})"):slice 1
print year + "/" + month
print "a  b   c":replace (pattern "\s+" everywhere), " "
print "Prose":match pattern "^prose$" ignoring case != null

"--- Types: optional annotations that describe exports to TypeScript. They"
"don't change what runs."
"A point on a grid."
export type Point is object
    x as number
    y as number
    "Points may have a label."
    label as maybe text
export function distance takes from_point as Point, to_point as Point, giving number
    return Math:hypot (to_point:x - from_point:x), (to_point:y - from_point:y)
export function welcome takes name as text, giving Greeting
    return greet name, "."
origin as Point is make_point 0, 0
print distance origin, point
print welcome "Lin"
double is function takes n as number giving number return n * 2
print double 21

"--- Exports: other modules could use these. A comment on the line just above"
"an export documents it."

"How many sections the tour has."
export function stop_count giving number
    return 18
export version as text is "tour 1"
print "Tour stops: " + (stop_count run) + ", " + version
