function cipher takes string, rotate
    ciphered_string is ""
    base_number is char_to_number "a"
    for i is 1 to length string
        char_number is (char_to_number string.i - base_number + rotate) mod 26 +
            base_number
        ciphered_string.i is number_to_char char_number
    return ciphered_string

print cipher "hello", 3
encoded is cipher "hello", 3
print cipher encoded, -3
print cipher "xyz", 3
print cipher "abc", -3
