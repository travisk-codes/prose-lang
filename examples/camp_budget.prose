"Plan a small camping trip with objects, arrays, functions, and a budget."

function line_total takes item
    return item:price * item:quantity

function make_bill takes items
    subtotal is 0
    for i is 1 to length items
        subtotal is subtotal + (line_total items.i)
    return object
        subtotal is subtotal
        tax is subtotal * 0.1
        total is subtotal + subtotal * 0.1

trip is object
    name is "Lakeside"
    budget is 60
    settings is object
        allow_spending is true
        prepaid is false
    emergency_contact is null

lantern is object
    name is "Lantern"
    price is 12.5
    quantity is 2

water is object
    name is "Water"
    price is 2.5
    quantity is 6

snacks is object
    name is "Snacks"
    price is 5
    quantity is 2

basket is lantern, water
basket.(length basket + 1) is snacks

print "Camp budget: " + trip:name
for i is 1 to length basket
    item is basket.i
    print item:name + ": " + (line_total item)

"Each call consumes one argument, so these three results make an array."
line_totals is line_total lantern, line_total water, line_total snacks
print line_totals

bill is make_bill basket
print "Subtotal: " + bill:subtotal
print "Tax: " + bill:tax
print "Total: " + bill:total

over_budget is bill:total > trip:budget
can_pay is trip:settings:allow_spending or trip:settings:prepaid
if not over_budget and can_pay and bill:total != 0
    trip:status is "ready"
else if bill:total = 0
    trip:status is "nothing to buy"
else
    trip:status is "revise the plan"

print "Status: " + trip:status
print "Budget remaining: " + (trip:budget - bill:total)
if trip:emergency_contact = null print "No emergency contact supplied."
