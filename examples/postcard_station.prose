"Rotate lowercase letters, preserving punctuation, uppercase letters, and"
"emoji."

function show_banner
    print "Postcard station"

function rotate_lowercase takes message, turns
    result is ""
    first_letter is char_to_number "a"
    last_letter is char_to_number "z"
    for i is 1 to length message
        character is message.i
        code is char_to_number character
        if code >= first_letter and code <= last_letter
            shifted is (code - first_letter + turns) mod 26 + first_letter
            result.i is number_to_char shifted
        else
            result.i is character
    return result

function show_postcard takes message, turns
    "An empty message exits early without printing anything."
    if length message = 0 return
    print rotate_lowercase message, turns

show_banner run
show_postcard "hello, zoo! 😀", 3
encoded is rotate_lowercase "hello, zoo! 😀", 3
show_postcard encoded, -3
show_postcard "", 3

"Visit three rotations using a while loop."
turns is -1
while turns < 2
    print rotate_lowercase "az", turns
    turns is turns + 1

"A bare variable starts unset; its first indexed write makes it a string."
stamp
stamp.1 is "a"
stamp.2 is "😀"
stamp.1 is "A"
stamp.(length stamp + 1) is "!"
print "Stamp: " + stamp
print "Stamp positions: " + (length stamp)

"The alternate unset declaration uses an empty right side."
spare is
if not spare print "Spare stamp is unset."
print "Missing position is unset: " + (stamp.99 = spare)
print "Quoted note: \"meet at noon\""
